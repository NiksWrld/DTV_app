FROM rust:1.80-slim-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY apps/api/Cargo.toml apps/api/
COPY apps/worker/Cargo.toml apps/worker/
COPY crates/ crates/
RUN mkdir -p apps/api/src apps/worker/src && echo "fn main() {}" > apps/api/src/main.rs
RUN cargo build --release -p dtv-api 2>/dev/null || true
COPY . .
RUN cargo build --release -p dtv-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/dtv-api /usr/local/bin/
EXPOSE 3001
CMD ["dtv-api"]
